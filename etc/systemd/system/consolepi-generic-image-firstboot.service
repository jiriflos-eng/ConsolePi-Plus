[Unit]
Description=ConsolePi generic image first-boot provisioning
Requires=consolepi-boot-network.service
After=local-fs.target consolepi-boot-network.service
Before=ssh.service nginx.service consolepi-web.service consolepi-port-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/consolepi-generic-image-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
