[Unit]
Description=ConsolePi selected event syslog forwarding
After=systemd-journald.service network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/consolepi_syslog.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=8
CapabilityBoundingSet=
RestrictSUIDSGID=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/consolepi-syslog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
